type Movie{
    id: ID!
    title: String!
    genre: String!
    directorId: ID!
    director: Director
    reviews: [Review!]!
}

type Director{
    id: ID!
    name: String!
    totalAwards: Int!
}

type Review{
    id: ID!
    comment: String
    rating: Int!
}

type Query{
    findMovieById(id: ID!): Movie
}

type Mutation{
    addReview(movieId: ID!, comment: String, rating: Int!): Movie
}